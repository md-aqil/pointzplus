# Used by docker-compose.yml (copy to .env). Optional provider keys
# (GEMINI_API_KEY, GOOGLE_CLIENT_ID, etc.) can go in .env or server/.env.
DB_NAME=pointzplus
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432
API_PORT=3001
APP_PORT=8081

# JWT Secret (REQUIRED - generate with: openssl rand -hex 32)
JWT_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://pointzplus.vibeship.in/api/email-sync/google/callback
WEB_RETURN_URL=https://pointzplus.vibeship.in/email-sync

# AI Statement Extraction APIs
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Deals and Webhook Secrets
LINKMYDEALS_API_KEY=
COUPOMATED_API_KEY=
TOKEN_ENCRYPTION_KEY=
CRON_SECRET=
PUBSUB_WEBHOOK_SECRET=

# Sync Worker Tuning
SYNC_WORKER_ENABLED=true
SYNC_WORKER_POLL_MS=2000
SYNC_WORKER_STALE_MINUTES=5
REJECTED_EMAILS_RETENTION_HOURS=24
AI_TIMEOUT_MS=7000
AI_MAX_RETRIES=1

# Mobile / Web App configuration
EXPO_PUBLIC_DEBUG=true
# EXPO_PUBLIC_API_URL=https://pointzplus.vibeship.in/api

