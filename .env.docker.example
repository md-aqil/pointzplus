# Used by docker-compose.yml (copy to .env). Optional provider keys
# (GEMINI_API_KEY, GOOGLE_CLIENT_ID, ...) can go in server/.env.
DB_NAME=pointzplus
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432
API_PORT=3001
APP_PORT=8081
# For physical devices (Expo Go): your computer LAN IP
# EXPO_PUBLIC_API_URL=http://192.168.x.x:3001/api
# REACT_NATIVE_PACKAGER_HOSTNAME=192.168.x.x
# Generate with: openssl rand -hex 32
JWT_SECRET=
