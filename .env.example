# API Configuration
# The app talks ONLY to the Express API. Never put database credentials here.
#
#   Android emulator : http://10.0.2.2:3001/api   (10.0.2.2 = your computer)
#   Physical Android : http://<your-computer-LAN-IP>:3001/api
#   iOS simulator/web: http://localhost:3001/api
#
# If you leave this unset, the app picks the right default for the current
# platform automatically. Set it explicitly only for a physical device.
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3001/api

# Debug
EXPO_PUBLIC_DEBUG=true