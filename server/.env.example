# Local PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pointzplus
DB_USER=postgres
DB_PASSWORD=postgres

# JWT Secret (REQUIRED – server refuses to start without it)
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Optional: separate key for token encryption (falls back to JWT_SECRET)
# TOKEN_ENCRYPTION_KEY=

# Server Port
PORT=3001

# ── Background Gmail sync worker ────────────────────────────────
# Jobs are queued in sync_jobs and claimed with FOR UPDATE SKIP LOCKED,
# so you can run multiple API instances and each will do its own share.
# Set SYNC_WORKER_ENABLED=false to run the API without an embedded worker
# (useful if you deploy a dedicated worker process instead).
SYNC_WORKER_ENABLED=true
# How often the worker looks for newly queued jobs.
SYNC_WORKER_POLL_MS=2000
# A job whose worker dies is recovered after this many minutes without a
# heartbeat, then retried (up to 3 attempts) before being marked failed.
SYNC_WORKER_STALE_MINUTES=5

# CORS allowlist (comma-separated origins; native apps don't send Origin)
# CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000

# Shared secret for POST /api/notifications/check-expiry (send as x-cron-secret header)
# CRON_SECRET=

# Shared secret for POST /api/email-sync/google/webhook (send as Authorization: Bearer <secret>)
# If unset, Google-issued OIDC JWTs are verified instead.
# PUBSUB_WEBHOOK_SECRET=
# Optional: expected OIDC audience for the Pub/Sub push JWT
# PUBSUB_WEBHOOK_AUDIENCE=

# Google OAuth (optional - for real email sync)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/email-sync/google/callback

# Outlook OAuth (optional)
OUTLOOK_CLIENT_ID=your-outlook-client-id
OUTLOOK_CLIENT_SECRET=your-outlook-client-secret